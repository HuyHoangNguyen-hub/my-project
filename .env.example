# Sao chép file này thành ".env" (cùng thư mục với run.py) rồi điền thông tin thật.
# File .env được app tự động nạp (qua python-dotenv) khi chạy "python run.py",
# không cần "export" biến môi trường thủ công mỗi lần mở terminal nữa.
# File .env KHÔNG được commit lên Git (đã có trong .gitignore).

# ----- Bắt buộc để gửi được email (vé, hoá đơn, mã quên mật khẩu) -----
# Ví dụ dùng Gmail: lấy Mật khẩu ứng dụng (App Password) 16 ký tự tại
# Tài khoản Google -> Bảo mật -> Xác minh 2 bước -> Mật khẩu ứng dụng
# (không dùng mật khẩu Gmail thường, Gmail sẽ chặn).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=your-email@gmail.com

# ----- Tuỳ chọn -----
# Khoá bí mật cho phiên đăng nhập. Nếu để trống, app tự sinh ngẫu nhiên mỗi lần
# khởi động (nghĩa là mọi người sẽ bị đăng xuất khi bạn restart server) — nên đặt
# một chuỗi cố định khi deploy thật.
SECRET_KEY=

# Đặt "1" khi chạy production qua HTTPS để bật cookie Secure.
HTTPS=
